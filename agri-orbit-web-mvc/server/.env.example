# AGRI-AI backend · copia este archivo a server/.env (NUNCA lo subas al repositorio)

# Proveedor compatible con la API de OpenAI (Chat Completions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Servidor
PORT=8787
# Orígenes permitidos para CORS (separados por coma). Ej.: https://davidrtx2.github.io
# En local, cualquier página en localhost/127.0.0.1 (Live Server, http.server) ya está permitida.
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:8080
# 1 = sirve también la web estática (desarrollo local / despliegue en un solo servicio)
SERVE_STATIC=1
# 1 si corre detrás de un proxy (Render, Railway, Fly) para leer la IP real en X-Forwarded-For
TRUST_PROXY=0

# Límites
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_BYTES=65536
UPSTREAM_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=800

# ---------------------------------------------------------------------------
# Parcelas de El Salvador · catastro del CNR (IGCN)
# El CNR entrega su servicio de mapas catastrales (WebMapService) mediante convenio
# institucional con cuentas de usuario. Mientras falte cualquiera de los campos
# obligatorios, la app muestra "Capa catastral pendiente de conexión" y no dibuja parcelas.
# NO uses el visor https://www.e.cnr.gob.sv/ClaveCatastral/ como API.
# (Los comentarios van en su propia línea: el cargador de .env no admite comentarios al final.)
#
# Obligatorios
# wms | arcgis (ArcGIS REST MapServer)
CNR_CADASTRE_PROTOCOL=
# https://… endpoint WMS o …/MapServer entregado por el CNR
CNR_CADASTRE_URL=
# nombre(s) WMS o ID(s) ArcGIS de la capa de parcelas
CNR_CADASTRE_LAYERS=
# referencia del convenio/autorización escrita del CNR
CNR_CADASTRE_AGREEMENT=
#
# Autenticación (solo en el servidor; nunca llega al navegador): none | basic | token | header
CNR_CADASTRE_AUTH=none
CNR_CADASTRE_USER=
CNR_CADASTRE_PASSWORD=
CNR_CADASTRE_TOKEN=
# parámetro de consulta para AUTH=token (ArcGIS usa "token")
CNR_CADASTRE_TOKEN_PARAM=token
# cabecera HTTP para AUTH=header
CNR_CADASTRE_HEADER_NAME=
#
# Servicio · versión WMS: 1.3.0 | 1.1.1
CNR_CADASTRE_WMS_VERSION=1.3.0
# EPSG:4326 | CRS:84 | EPSG:3857 (debe figurar en GetCapabilities)
CNR_CADASTRE_CRS=EPSG:4326
# formato de GetFeatureInfo: application/json, application/geo+json o text/xml
CNR_CADASTRE_INFO_FORMAT=application/json
# 0 si el servicio no permite consultar atributos
CNR_CADASTRE_QUERY=1
# nombre exacto del campo de clave catastral (si se deja vacío, se detecta por nombre)
CNR_CADASTRE_KEY_FIELD=
#
# Metadatos que la app muestra junto a la fuente
CNR_CADASTRE_ATTRIBUTION=Centro Nacional de Registros (CNR) · Instituto Geográfico y del Catastro Nacional (IGCN)
# fecha de actualización informada por el CNR (si existe)
CNR_CADASTRE_UPDATED=
# zonas con cobertura confirmada: w,s,e,n;w,s,e,n (lon/lat)
CNR_CADASTRE_COVERAGE=
#
# Límites · ancho máximo de la vista (°) para pedir parcelas (~5,5 km)
CNR_CADASTRE_MAX_SPAN_DEG=0.05
CNR_CADASTRE_TIMEOUT_MS=15000
# solicitudes por minuto e IP
CNR_CADASTRE_RATE_MAX=240
# 1 SOLO si existe una fuente adicional autorizada para mostrar propietario/historial registral
CNR_CADASTRE_ALLOW_OWNER_FIELDS=0
